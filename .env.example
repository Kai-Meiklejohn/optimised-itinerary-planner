# Browser configuration only. All VITE_ values are visible to browser users.
# Copy to .env.local and use resources from your own AWS account.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_CLIENT_ID=replace-with-your-cognito-app-client-id
VITE_API_BASE_URL=http://localhost:3001
VITE_BACKEND_API_URL=http://localhost:3001

# Restricted Amazon Location browser key. Never put AWS access credentials here.
VITE_AWS_LOCATION_API_KEY=
VITE_LOCATION_MAP_NAME=itinerary-planner-map
VITE_LOCATION_PLACE_INDEX_NAME=itinerary-planner-places

# Optional separate key restricted to geo-routes:CalculateRoutes.
VITE_AWS_ROUTES_API_KEY=
