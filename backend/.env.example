# Use your own AWS CLI profile. Prefer temporary credentials through AWS SSO.
AWS_PROFILE=itinerary-dev
AWS_REGION=us-east-1

# Values from `terraform -chdir=infra output`.
USER_TABLE_NAME=itinerary-planner-users
TRIP_TABLE_NAME=Trip
STOP_TABLE_NAME=Stop
RATE_LIMIT_TABLE_NAME=itinerary-planner-rate-limit
COGNITO_USER_POOL_ID=replace-with-your-cognito-user-pool-id
COGNITO_CLIENT_ID=replace-with-your-cognito-app-client-id
